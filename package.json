{
  "name": "rolemate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <25"
  },
  "pnpm": {
    "overrides": {
      "@fastify/static": "10.1.2"
    }
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "dev": "corepack pnpm -r --parallel --if-present run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "corepack pnpm -r --if-present run lint",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "test:migrations": "corepack pnpm --filter @rolemate/testing test",
    "assets:generate": "tsx scripts/generate-assets.ts",
    "verify": "powershell -ExecutionPolicy Bypass -File toolkit/verify.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.16.5",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "tsx": "^4.20.3",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
